# Copy values into your deployment platform (Railway/Render/etc.)

# Solana cluster and RPC (must match where the program is deployed)
SOLANA_CLUSTER=mainnet
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Lotto program configuration
LOTTO_PROGRAM_ID=CRN6xipYR35mQeAzPFvatKYk6WsTfzhbWshrMp2Jn3FR

# Provide ONE of the following (not both):
# Paste the entire single-line JSON from scripts/lotto.idl.min.json
# LOTTO_IDL_JSON=

# Or paste the entire base64 content from scripts/lotto.idl.base64.txt
# LOTTO_IDL_BASE64=

# Backend required envs (fill these with your real values)
TELEGRAM_BOT_TOKEN=
DATABASE_URL=
ADMIN_API_KEY=
# Wallet used for round init/settle; keep funded on mainnet
AUTHORITY_SECRET_KEY=
